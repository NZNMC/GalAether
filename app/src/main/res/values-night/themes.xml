<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GalStore" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 启动画面(夜间):深色背景 -->
    <style name="Theme.GalStore.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1C1B1F</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.GalStore</item>
    </style>
</resources>
