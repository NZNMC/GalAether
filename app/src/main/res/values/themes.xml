<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GalStore" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 启动画面:打开 App 的瞬间显示图标 -->
    <style name="Theme.GalStore.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFBFE</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.GalStore</item>
    </style>
</resources>
